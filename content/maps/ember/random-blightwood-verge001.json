      "lines": [
        {
          "id": "start",
          "speaker": "Narrador",
          "text": "Where the green wood ends, every trunk beyond is grey and dead. Candles burn at a ruined wayside shrine, and the things kneeling before it rise as you step onto the trail."
        }
      ]
    },
