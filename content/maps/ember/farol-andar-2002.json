rn-01", "x": 14, "y": 7}, {"id": "ember-lighthouse-clockwork", "x": 13, "y": 15}, {"id": "torture-brazier", "x": 9, "y": 13}, {"id": "torture-brazier", "x": 17, "y": 13}, {"id": "ember-interior-long-bench-v02", "x": 12, "y": 20}, {"id": "ember-treasure-workbench-v02", "x": 17, "y": 15}, {"id": "cave-hanging-chains", "x": 13, "y": 17}, {"id": "ember-props-crate-v02", "x": 8, "y": 15}, {"id": "ember-polyhaven-wooden-stool-02", "x": 14, "y": 19}, {"id": "ember-ember-ember-lantern", "x": 11, "y": 14}, {"id": "ember-ember-ember-lantern", "x": 15, "y": 14}, {"id": "ember-treasure-weapon-rack-v02", "x": 7, "y": 14}, {"id": "ember-arch-farol-stairs-down", "x": 9, "y": 17, "rot": 0, "wallOrientation": "horizontal"}, {"id": "floor-connector", "x": 9, "y": 17, "targetMapId": "farol", "connectorDirection": "down", "returnConnector": true}, {"id": "ember-arch-farol-stairs-up", "x": 16, "y": 17, "rot": 0, "wallOrientation": "horizontal"}, {"id": "floor-connector", "x": 16, "y": 17, "targetMapId": "farol-topo", "connectorDirection": "up"}], "elementalFx": [], "playerSpawns": [{"name": "Kael", "classId": "kaelFinal", "x": 10, "y": 18, "level": 15}], "enemySpawns": [{"name": "Vigia Afogado", "classId": "apparition", "x": 11, "y": 16, "level": 11}, {"name": "Vigia Afogado", "classId": "apparition", "x": 15, "y": 19, "level": 11}, {"name": "Afogado", "classId": "zombie2", "x": 13, "y": 13, "level": 10}, {"name": "Horror Menor", "classId": "minorHorror", "x": 10, "y": 7, "level": 11}], "neutralSpawns": [{"name": "Aprendiz do Faroleiro", "classId": "peasant1", "x": 16, "y": 6, "level": 3, "dialog": {"id": "npc-farol-aprendiz", "startId": "l1", "lines": [{"id": "l1", "text": "Não abram a porta de cima! ...Vocês estão vivos. Secos. Faz tempo que eu não vejo ninguém seco.", "replies": [{"text": "O que aconteceu com o faroleiro?", "next": "l2"}, {"text": "O que queima na lanterna?", "next": "l3"}, {"text": "Fique escondido."}], "speaker": "Aprendiz do Faroleiro"}, {"id": "l2", "text": "Mestre Anselmo nunca deixou a luz apagar. Nem na tempestade de cinza, quando o óleo acabou. Ele desceu à gruta e voltou com uma pedra que brilhava. Pôs na lanterna. A luz ficou laranja. Ele ficou... magro. Depois ficou claro. Depois eu enxergava a parede através dele.", "next": null, "speaker": "Aprendiz do Faroleiro"}, {"id": "l3", "text": "Ember. E ele. Os dois queimam juntos. A corda do relógio eu ainda dou, toda noite, porque se a lente parar ele desce para ver por quê. Se forem subir: ele não apaga, e não deixa apagar. Quebrem a lanterna e ele não tem onde ficar.", "next": null, "speaker": "Aprendiz do Faroleiro"}]}}], "aboveGround": true, "baseTile": "nave", "emberTiles": "torre-v01"}}