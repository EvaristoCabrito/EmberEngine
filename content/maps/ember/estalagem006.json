    "enemySpawns": [],
    "neutralSpawns": [
      {
        "name": "Brue",
        "classId": "brue",
        "x": 6,
        "y": 4,
        "dialog": {
          "id": "npc-brue",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Brue",
              "portrait": "brue",
              "text": "O fogo ainda pega. As camas, não. Gold compra o que sobrou da adega. Salazar pode levar frasco — não precisa, mas o copo não recusa.",
              "replies": [
                {
                  "text": "Ver a adega",
                  "action": "tavern"
                },
                {
                  "text": "Depois."
                }
              ]
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Vargan",
        "classId": "miliciaV2",
        "x": 19,
        "y": 12,
        "dialog": {
          "id": "npc-vargan",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Vargan",
              "portrait": "soldier",
              "text": "A forja é lá embaixo. Desce comigo, se tiver Gold — aço bom não se vende fiado.",
              "replies": [
                {
                  "text": "Descer à forja",
                  "action": "smith"
                },
                {
                  "text": "Agora não."
                }
              ]
            }
          ]
        },
        "level": 3
      },
      {
        "name": "O Mudo",
        "classId": "mudinho",
        "x": 5,
        "y": 10,
        "dialog": {
          "id": "npc-mudo",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "O Mudo",
              "portrait": "mudinho",
              "text": "Ele não fala. Nunca. Carrega uma pequena tábua de madeira e um pedaço de giz, e usa-a para responder quando não pode simplesmente apontar ou ir embora. Na tábua, uma frase aparece repetidamente: “Não fique parado por muito tempo.” Ninguém sabe de onde ele veio. Conhece estradas que não aparecem em mapa algum e parece sempre estar a caminho de algum lugar. Quando perguntam quanto custa uma bebida na velha adega, ele escreve apenas: “Ainda tem preço.”",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "A Hóspede",
        "classId": "cultist",
        "x": 21,
        "y": 12,
        "dialog": {
          "id": "npc-hospede",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "A Hóspede",
              "portrait": "sorcerer",
              "text": "Não subo. O chão me conhece. Tragam histórias, não luz. Se Brue ainda mede Gold, o mundo não acabou.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Beberrão",
        "classId": "beberrao",
        "x": 4,
        "y": 5,
        "dialog": {
          "id": "npc-beberrao",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Beberrão",
              "portrait": "beberrao",
              "text": "Mais um copo e eu esqueço a estrada. Dois, e esqueço quem me esperava nela.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Padeira",
        "classId": "breadLady",
        "x": 13,
        "y": 8,
        "dialog": {
          "id": "npc-padeira",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Padeira",
              "portrait": "breadLady",
              "text": "Pão de cinza, mas é pão. A farinha vem de onde o fogo não chegou — cada vez mais longe.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Louca da Vela",
        "classId": "crazyLady",
        "x": 12,
        "y": 13,
        "dialog": {
          "id": "npc-louca",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Louca da Vela",
              "portrait": "crazyLady",
              "text": "Não apaguem. Não apaguem! Enquanto a chama dança, eles não entram pela janela.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Curandeiro Ancião",
        "classId": "oldHealer",
        "x": 17,
        "y": 2,
        "dialog": {
          "id": "npc-curandeiro",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Curandeiro Ancião",
              "portrait": "oldHealer",
              "text": "Já costurei mais gente esta semana do que num inverno inteiro. Se sangrar, não demore.",
              "replies": [
                {
                  "text": "Preciso de Cura Média.",
                  "next": "offer"
                },
                {
                  "text": "Quanto custa o seu tratamento?",
                  "next": "price"
                },
                {
                  "text": "Só estava de passagem.",
                  "next": "farewell"
                }
              ]
            },
            {
              "id": "offer",
              "speaker": "Curandeiro Ancião",
              "portrait": "oldHealer",
              "text": "“Uma Cura Média restaura um quarto do HP máximo. São cinco Gold por conjuração; quatro conjurações restauram até o HP total. Posso tratar cada um separadamente ou cuidar de todos.”",
              "replies": [
                {
                  "text": "Abrir o menu de cura.",
                  "action": "healer"
                },
                {
                  "text": "Vou pensar um pouco.",
                  "next": "farewell"
                }
              ]
            },
            {
              "id": "price",
              "speaker": "Curandeiro Ancião",
              "portrait": "oldHealer",
              "text": "“Cinco Gold por conjuração. O menu mostra o HP de cada pessoa e o custo antes de eu começar.”",
              "replies": [
                {
                  "text": "Então vamos tratar o grupo.",
                  "next": "offer"
                },
                {
                  "text": "Obrigado. Talvez depois.",
                  "next": "farewell"
                }
              ]
            },
            {
              "id": "farewell",
              "speaker": "Curandeiro Ancião",
              "portrait": "oldHealer",
              "text": "Ele volta a organizar as faixas e os frascos sobre a mesa.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Camponês",
        "classId": "peasant1",
        "x": 10,
        "y": 8,
        "dialog": {
          "id": "npc-campones",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Camponês",
              "portrait": "peasant1",
              "text": "Queimaram o campo e a colheita junto. Agora eu planto conversa aqui dentro.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Cliente Suspeito",
        "classId": "shadyPatron",
        "x": 21,
        "y": 8,
        "dialog": {
          "id": "npc-suspeito",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "Ele espera até que a mesa ao lado se distraia. “Sente-se. Se alguém perguntar, não nos conhecemos. O que quer saber?”",
              "replies": [
                {
                  "text": "Você mencionou a Torre de Vigia.",
                  "next": "watchtower"
                },
                {
                  "text": "O que sabe da Companhia Carmesim?",
                  "next": "company"
                },
                {
                  "text": "Por que está tão preocupado em ser visto?",
                  "next": "wary"
                }
              ]
            },
            {
              "id": "watchtower",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "Ele baixa a voz. “A Torre está nas mãos de gente que não costuma fazer prisioneiros por muito tempo.”",
              "replies": [
                {
                  "text": "Quem lhe contou isso?",
                  "next": "source"
                },
                {
                  "text": "Quem está preso lá?",
                  "next": "hostage"
                },
                {
                  "text": "Você parece saber mais do que diz.",
                  "next": "wary"
                }
              ]
            },
            {
              "id": "company",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "Ao ouvir o nome da Companhia Carmesim, ele para de mexer o copo. “Já vi o que resta de um regimento quando seus oficiais desaparecem.”",
              "replies": [
                {
                  "text": "Um oficial da Companhia está na Torre?",
                  "next": "hostage"
                },
                {
                  "text": "Você serviu com eles?",
                  "next": "service"
                },
                {
                  "text": "O que aconteceu com o regimento?",
                  "next": "wary"
                }
              ]
            },
            {
              "id": "wary",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "Ele observa a sala antes de responder. “Eu faço perguntas antes de confiar. Quem fala demais acaba no lugar errado, na hora errada.”",
              "replies": [
                {
                  "text": "Não quero causar problemas. Só quero entender.",
                  "next": "watchtower"
                },
                {
                  "text": "Você tem medo de que descubram que está falando?",
                  "next": "source"
                },
                {
                  "text": "Então vou direto ao ponto: quem está preso?",
                  "next": "hostage"
                }
              ]
            },
            {
              "id": "service",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "“Não. Mas conheci soldados que serviram. Alguns nomes ainda fazem as pessoas olharem por cima do ombro.” Ele se cala, como se tivesse dito demais.",
              "replies": [
                {
                  "text": "Está falando do oficial na Torre?",
                  "next": "hostage"
                },
                {
                  "text": "Pode confiar em mim.",
                  "next": "wary"
                }
              ]
            },
            {
              "id": "source",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "Ele aperta o copo. “Não vou dizer quem me contou. Nem como essa pessoa soube. Se é isso que procura, a conversa acaba aqui.”",
              "replies": [
                {
                  "text": "Tudo bem. O que pode me dizer?",
                  "next": "hostage"
                },
                {
                  "text": "Pelo menos me diga se é mesmo um soldado.",
                  "next": "hostage"
                },
                {
                  "text": "Não vou pressioná-lo.",
                  "next": "leave"
                }
              ]
            },
            {
              "id": "hostage",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "Ele hesita, olhando de novo para a sala. “Há um oficial de alta patente da Companhia Carmesim mantido como refém na Torre de Vigia. É tudo que posso confirmar.”",
              "replies": [
                {
                  "text": "Qual é o nome dele?",
                  "next": "refusal"
                },
                {
                  "text": "Quem passou essa informação?",
                  "next": "refusal"
                },
                {
                  "text": "O que quer que eu faça?",
                  "next": "offer"
                }
              ]
            },
            {
              "id": "refusal",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "“Não.” A resposta sai seca. “Não direi o nome e não direi de onde veio a informação. Já arrisquei demais só em confirmar que existe um cativo.”",
              "replies": [
                {
                  "text": "Entendido. O que espera de mim?",
                  "next": "offer"
                },
                {
                  "text": "Sem mais detalhes, não posso prometer nada.",
                  "next": "leave"
                }
              ]
            },
            {
              "id": "offer",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "“Tire o oficial da cela na Torre de Vigia. Se conseguir trazê-lo de volta, haverá pagamento. Não pergunte o nome dele. E, por tudo que é sagrado, não tente descobrir quem me contou.”",
              "replies": [
                {
                  "text": "Vou resgatá-lo. Pode contar comigo.",
                  "action": "acceptSuspectHostageQuest"
                },
                {
                  "text": "Não posso me envolver nisso.",
                  "next": "leave"
                }
              ]
            },
            {
              "id": "leave",
              "speaker": "Cliente Suspeito",
              "portrait": "shadyPatron",
              "text": "Ele termina a bebida e vira o copo vazio para baixo. “Então não tivemos esta conversa.”",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Velha da Sopa",
        "classId": "soupLady",
        "x": 19,
        "y": 2,
        "dialog": {
          "id": "npc-sopa",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Velha da Sopa",
              "portrait": "soupLady",
              "text": "Sopa de raiz e osso. Ninguém pergunta de quê, e é melhor assim.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Aldeã",
        "classId": "villagerF1",
        "x": 11,
        "y": 6,
        "dialog": {
          "id": "npc-alde",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Aldeã",
              "portrait": "villagerF1",
              "text": "Dizem que a estrada norte ainda está aberta. Dizem muita coisa. Ninguém volta pra confirmar.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Lenhador",
        "classId": "woodsman",
        "x": 21,
        "y": 3,
        "dialog": {
          "id": "npc-lenhador",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Lenhador",
              "portrait": "woodsman",
              "text": "Machado não corta cinza. Tenho que andar dois dias pra achar tronco que ainda seja tronco.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Neera",
        "classId": "neera",
        "x": 17,
        "y": 7,
        "dialog": {
          "id": "npc-neera",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Neera",
              "portrait": "neera",
              "text": "Três saídas, duas janelas, uma escada. Conto antes de sentar. Hábito — e é por isso que ainda sento.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Voss",
        "classId": "voss",
        "x": 19,
        "y": 10,
        "dialog": {
          "id": "npc-voss",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Voss",
              "portrait": "voss",
              "text": "Brue corta o vinho com água de chuva. Sinto o gosto da cinza em cada gole. Bebo mesmo assim.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Salazar",
        "classId": "salazar",
        "x": 15,
        "y": 2,
        "dialog": {
          "id": "npc-salazar",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Salazar",
              "portrait": "salazar",
              "text": "Um copo não fere a fé. Dois, talvez. Não conte a ninguém quantos foram, Kael.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Aldric",
        "classId": "aldric",
        "x": 8,
        "y": 4,
        "dialog": {
          "id": "npc-aldric",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Aldric",
              "portrait": "aldric",
              "text": "Descansa enquanto dá. Lá fora ninguém vai nos dar outra noite como esta.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Malrec",
        "classId": "conjurer",
        "x": 18,
        "y": 7,
        "dialog": {
          "id": "npc-malrec",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Malrec",
              "portrait": "conjurer",
              "text": "O familiar não gosta daqui. Gente demais, sombra de menos. Por isso mesmo eu gosto.",
              "next": null
            }
          ]
        },
        "level": 3
      }
    ]
  }
