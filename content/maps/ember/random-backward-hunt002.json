    "neutralSpawns": [
      {
        "name": "Erasmo",
        "classId": "shadowScholar",
        "x": 2,
        "y": 9,
        "dialog": {
          "id": "encounter-shadowScholar",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Erasmo",
              "portrait": "shadowScholar",
              "text": "Minha sombra está atrasada outra vez. Veja: eu já terminei este capítulo e ela ainda está na margem.",
              "replies": [
                {
                  "text": "Você está discutindo com a sombra?",
                  "next": "answer1"
                },
                {
                  "text": "O livro fala sobre o quê?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Erasmo",
              "portrait": "shadowScholar",
              "text": "Estou corrigindo sua interpretação. É uma diferença acadêmica muito importante para quem convive com ela o dia inteiro."
            },
            {
              "id": "answer2",
              "speaker": "Erasmo",
              "portrait": "shadowScholar",
              "text": "Sobre a distância entre o que vemos e o que entendemos. O autor morreu antes do último capítulo. Muito conveniente."
            }
          ]
        },
        "level": 1
      }
    ],
    "introDialogEnabled": true,
    "introDialog": {
      "id": "random-backward-hunt-intro",
      "startId": "start",
      "lines": [
        {
          "id": "start",
          "speaker": "Narrador",
          "text": "Uma pequena criatura branca cruza a trilha com uma flecha prateada na boca, deixando pegadas humanas. Caçadores sem pegadas surgem da tormenta. A presa roubou a flecha para interromper uma caçada que se repete há séculos; vocês se colocam entre ela e os perseguidores."
        }
      ]
    },
    "outroDialogEnabled": true,
    "outroDialog": {
      "id": "random-backward-hunt-outro",
      "startId": "start",
      "lines": [
        {
          "id": "start",
          "speaker": "Narrador",
          "text": "Com os perseguidores vencidos, a flecha se desfaz ao primeiro brilho da aurora. As pegadas humanas desaparecem e a pequena criatura segue livre. Pela primeira vez em séculos, a trilha permanece em silêncio."
        }
      ]
    }
  }
