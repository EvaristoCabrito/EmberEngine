    "neutralSpawns": [
      {
        "name": "Gaspar",
        "classId": "marshTrapper",
        "x": 2,
        "y": 9,
        "dialog": {
          "id": "encounter-marshTrapper",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Gaspar",
              "portrait": "marshTrapper",
              "text": "Cuidado onde pisa. Minha armadilha pega coelho; a dos outros pega gente.",
              "replies": [
                {
                  "text": "Quem armou o caminho?",
                  "next": "answer1"
                },
                {
                  "text": "Caçou alguma coisa estranha?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Gaspar",
              "portrait": "marshTrapper",
              "text": "Mãos apressadas. O nó foi feito para ser puxado de longe. Se encontrar corda atravessando a trilha, procure o dono antes de cortar."
            },
            {
              "id": "answer2",
              "speaker": "Gaspar",
              "portrait": "marshTrapper",
              "text": "Uma vez segui pegadas que terminavam no alto de um pinheiro. Desde então só caço o que sei cozinhar."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Tereza",
        "classId": "ratCatcher",
        "x": 4,
        "y": 10,
        "dialog": {
          "id": "encounter-ratCatcher",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Tereza",
              "portrait": "ratCatcher",
              "text": "Esta gaiola está vazia. Não quer dizer que o serviço acabou.",
              "replies": [
                {
                  "text": "Há ratos aqui?",
                  "next": "answer1"
                },
                {
                  "text": "Por que olha tanto a gaiola?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Tereza",
              "portrait": "ratCatcher",
              "text": "Onde há saco de comida, há rato. Onde há palácio, há rato com título. Eu cobro igual."
            },
            {
              "id": "answer2",
              "speaker": "Tereza",
              "portrait": "ratCatcher",
              "text": "Ontem eu a fechei vazia. Hoje alguém roeu a tranca por dentro. Vai dizer que também não olharia?"
            }
          ]
        },
        "level": 1
      }
    ],
    "introDialogEnabled": true,
    "introDialog": {
      "id": "random-small-toll-collector-intro",
      "startId": "start",
      "lines": [
        {
          "id": "start",
          "speaker": "Narrador",
          "text": "Um pequeno cobrador, enrolado num casaco enorme, exige sopa quente, uma piada ou um segredo. Atrás dele, uma cabra com chifres de madeira parece comandar a conversa. Seus comparsas decidem cobrar o pedágio à força."
        }
      ]
    },
    "outroDialogEnabled": true,
    "outroDialog": {
      "id": "random-small-toll-collector-outro",
      "startId": "start",
      "lines": [
        {
          "id": "start",
          "speaker": "Narrador",
          "text": "Sem os comparsas, o cobrador admite a derrota e revela o caminho protegido da avalanche. A cabra dá uma cabeçada nele: aparentemente, era ela quem mandava."
        }
      ]
    }
  }
}
