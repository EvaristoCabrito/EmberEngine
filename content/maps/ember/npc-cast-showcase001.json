    "neutralSpawns": [
      {
        "name": "Nara",
        "classId": "roadCartographer",
        "x": 2,
        "y": 11,
        "dialog": {
          "id": "encounter-roadCartographer",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Nara",
              "portrait": "roadCartographer",
              "text": "Este mapa diz que há uma ponte adiante. A bússola discorda. Eu costumo confiar na que não cobra tinta.",
              "replies": [
                {
                  "text": "Por que a bússola discorda?",
                  "next": "answer1"
                },
                {
                  "text": "Qual caminho você recomenda?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Nara",
              "portrait": "roadCartographer",
              "text": "Aqui a agulha segue alguma coisa enterrada. Uma ponte cai uma vez; uma direção errada derruba a viagem inteira."
            },
            {
              "id": "answer2",
              "speaker": "Nara",
              "portrait": "roadCartographer",
              "text": "Pela margem baixa. Procure as pedras claras e mantenha o rio à direita. Se ouvir alguém chamar do mato, confira primeiro se trouxe companhia."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Bento",
        "classId": "mushroomForager",
        "x": 4,
        "y": 12,
        "dialog": {
          "id": "encounter-mushroomForager",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Bento",
              "portrait": "mushroomForager",
              "text": "Não toque nos roxos. Eles são ótimos para ver estrelas... mesmo ao meio-dia.",
              "replies": [
                {
                  "text": "Os outros são seguros?",
                  "next": "answer1"
                },
                {
                  "text": "Você mora aqui?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Bento",
              "portrait": "mushroomForager",
              "text": "Os marrons, sim. Os brancos dependem. Dos que falam, eu não como nenhum: acho falta de educação."
            },
            {
              "id": "answer2",
              "speaker": "Bento",
              "portrait": "mushroomForager",
              "text": "Morar é uma palavra forte. Tenho um teto de folhas e vizinhos que não pedem açúcar. Já tive coisa pior."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Baltasar",
        "classId": "bellCollector",
        "x": 0,
        "y": 12,
        "dialog": {
          "id": "encounter-bellCollector",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Baltasar",
              "portrait": "bellCollector",
              "text": "Silêncio. Este sino acabou de responder a uma pergunta que ninguém fez.",
              "replies": [
                {
                  "text": "O que ele disse?",
                  "next": "answer1"
                },
                {
                  "text": "Você coleciona sinos?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Baltasar",
              "portrait": "bellCollector",
              "text": "Que faltava uma voz no bosque. Talvez a minha. Talvez a sua. Prefiro não conferir sozinho."
            },
            {
              "id": "answer2",
              "speaker": "Baltasar",
              "portrait": "bellCollector",
              "text": "Coleciono os intervalos entre eles. Os sinos só ajudam a carregar."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Ofélia",
        "classId": "mothKeeper",
        "x": 5,
        "y": 14,
        "dialog": {
          "id": "encounter-mothKeeper",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Ofélia",
              "portrait": "mothKeeper",
              "text": "Elas não procuram a luz. Procuram o que a luz tenta esconder.",
              "replies": [
                {
                  "text": "Por que carrega mariposas?",
                  "next": "answer1"
                },
                {
                  "text": "Elas conhecem o caminho?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Ofélia",
              "portrait": "mothKeeper",
              "text": "Cada uma voltou de uma casa vazia. Enquanto alguém se lembrar dos moradores, eu mantenho a porta aberta."
            },
            {
              "id": "answer2",
              "speaker": "Ofélia",
              "portrait": "mothKeeper",
              "text": "Melhor que nós. Mas não peça para guiá-lo: algumas saudades levam longe demais."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Dário",
        "classId": "charcoalBurner",
        "x": 4,
        "y": 10,
        "dialog": {
          "id": "encounter-charcoalBurner",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Dário",
              "portrait": "charcoalBurner",
              "text": "O fogo faz o serviço. Eu só passo o dia convencendo a madeira a não discutir.",
              "replies": [
                {
                  "text": "Viu gente armada por aqui?",
                  "next": "answer1"
                },
                {
                  "text": "Como se ganha a vida aqui?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Dário",
              "portrait": "charcoalBurner",
              "text": "Vi botas limpas entrando e botas ensanguentadas saindo. Gente honesta costuma deixar a lama fazer o trabalho primeiro."
            },
            {
              "id": "answer2",
              "speaker": "Dário",
              "portrait": "charcoalBurner",
              "text": "Um saco de carvão de cada vez. A cidade quer calor, mas prefere esquecer de onde ele vem."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Ada",
        "classId": "wanderingTinker",
        "x": 4,
        "y": 16,
        "dialog": {
          "id": "encounter-wanderingTinker",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Ada",
              "portrait": "wanderingTinker",
              "text": "Se faz barulho, tem conserto. Quando fica quieto demais é que eu começo a cobrar por preocupação.",
              "replies": [
                {
                  "text": "Pode consertar essa chaleira?",
                  "next": "answer1"
                },
                {
                  "text": "O que viu na estrada?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Ada",
              "portrait": "wanderingTinker",
              "text": "Posso. Ela perdeu uma alça e a dignidade, mas ainda guarda água melhor que muita gente guarda segredo."
            },
            {
              "id": "answer2",
              "speaker": "Ada",
              "portrait": "wanderingTinker",
              "text": "Uma carroça sem roda, três mentiras bem vestidas e um homem negociando com uma árvore. A árvore parecia levar vantagem."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Gaspar",
        "classId": "marshTrapper",
        "x": 0,
        "y": 10,
        "dialog": {
          "id": "encounter-marshTrapper",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Gaspar",
              "portrait": "marshTrapper",
              "text": "Cuidado onde pisa. Minha armadilha pega coelho; a dos outros pega gente.",
              "replies": [
                {
                  "text": "Quem armou o caminho?",
                  "next": "answer1"
                },
                {
                  "text": "Caçou alguma coisa estranha?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Gaspar",
              "portrait": "marshTrapper",
              "text": "Mãos apressadas. O nó foi feito para ser puxado de longe. Se encontrar corda atravessando a trilha, procure o dono antes de cortar."
            },
            {
              "id": "answer2",
              "speaker": "Gaspar",
              "portrait": "marshTrapper",
              "text": "Uma vez segui pegadas que terminavam no alto de um pinheiro. Desde então só caço o que sei cozinhar."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Tereza",
        "classId": "ratCatcher",
        "x": 0,
        "y": 16,
        "dialog": {
          "id": "encounter-ratCatcher",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Tereza",
              "portrait": "ratCatcher",
              "text": "Esta gaiola está vazia. Não quer dizer que o serviço acabou.",
              "replies": [
                {
                  "text": "Há ratos aqui?",
                  "next": "answer1"
                },
                {
                  "text": "Por que olha tanto a gaiola?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Tereza",
              "portrait": "ratCatcher",
              "text": "Onde há saco de comida, há rato. Onde há palácio, há rato com título. Eu cobro igual."
            },
            {
              "id": "answer2",
              "speaker": "Tereza",
              "portrait": "ratCatcher",
              "text": "Ontem eu a fechei vazia. Hoje alguém roeu a tranca por dentro. Vai dizer que também não olharia?"
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Erasmo",
        "classId": "shadowScholar",
        "x": 2,
        "y": 17,
        "dialog": {
          "id": "encounter-shadowScholar",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Erasmo",
              "portrait": "shadowScholar",
              "text": "Minha sombra está atrasada outra vez. Veja: eu já terminei este capítulo e ela ainda está na margem.",
              "replies": [
                {
                  "text": "Você está discutindo com a sombra?",
                  "next": "answer1"
                },
                {
                  "text": "O livro fala sobre o quê?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Erasmo",
              "portrait": "shadowScholar",
              "text": "Estou corrigindo sua interpretação. É uma diferença acadêmica muito importante para quem convive com ela o dia inteiro."
            },
            {
              "id": "answer2",
              "speaker": "Erasmo",
              "portrait": "shadowScholar",
              "text": "Sobre a distância entre o que vemos e o que entendemos. O autor morreu antes do último capítulo. Muito conveniente."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Rúben",
        "classId": "swampFerryman",
        "x": 6,
        "y": 12,
        "dialog": {
          "id": "encounter-swampFerryman",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Rúben",
              "portrait": "swampFerryman",
              "text": "A água parece rasa porque quer que você desça primeiro.",
              "replies": [
                {
                  "text": "Onde fica a travessia?",
                  "next": "answer1"
                },
                {
                  "text": "Você conhece este rio?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Rúben",
              "portrait": "swampFerryman",
              "text": "Perto das pedras largas, ao sul. Solte a correia da mochila antes de entrar. Se a corrente puxar, deixe a carga ir."
            },
            {
              "id": "answer2",
              "speaker": "Rúben",
              "portrait": "swampFerryman",
              "text": "Conheço o que ele mostra. O resto eu respeito. É assim que um barqueiro chega a velho."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Lia",
        "classId": "lostCourier",
        "x": 6,
        "y": 10,
        "dialog": {
          "id": "encounter-lostCourier",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Lia",
              "portrait": "lostCourier",
              "text": "A carta está seca. As botas não. Considero isso uma vitória profissional.",
              "replies": [
                {
                  "text": "Está perdida?",
                  "next": "answer1"
                },
                {
                  "text": "Para quem é a carta?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Lia",
              "portrait": "lostCourier",
              "text": "Estou fora do caminho. Perdida seria se eu tivesse desistido. Há uma diferença, e ela é tudo o que tenho agora."
            },
            {
              "id": "answer2",
              "speaker": "Lia",
              "portrait": "lostCourier",
              "text": "Para alguém que ainda está esperando. O selo não é meu para abrir; a promessa é minha para cumprir."
            }
          ]
        },
        "level": 1
      }
    ],
    "introDialogEnabled": true,
    "outroDialogEnabled": true
  }
}
