 "ember-interior-stool", "x": 21, "y": 2}, {"id": "city-sack-pile", "x": 30, "y": 2}, {"id": "city-sack-pile", "x": 31, "y": 2}, {"id": "city-sack-pile", "x": 1, "y": 4}, {"id": "city-sack-pile", "x": 14, "y": 4}, {"id": "city-sack-pile", "x": 16, "y": 4}, {"id": "ember-interior-stool", "x": 24, "y": 4}, {"id": "city-sack-pile", "x": 31, "y": 4}, {"id": "city-basket", "x": 9, "y": 7}, {"id": "light-brazier-bowl", "x": 23, "y": 7}, {"id": "city-barrels", "x": 31, "y": 7}, {"id": "light-wall-torch", "x": 0, "y": 10}, {"id": "city-barrels", "x": 1, "y": 9}, {"id": "light-brazier-bowl", "x": 31, "y": 9}, {"id": "city-firewood-pile", "x": 17, "y": 11}, {"id": "light-candle", "x": 18, "y": 13}, {"id": "city-crate-stack", "x": 24, "y": 13}, {"id": "city-sack-pile", "x": 1, "y": 14}, {"id": "city-sack-pile", "x": 10, "y": 14}, {"id": "ember-interior-stool", "x": 17, "y": 14}, {"id": "city-crate-stack", "x": 27, "y": 14}, {"id": "city-covered-crate", "x": 31, "y": 14}, {"id": "city-sack-pile", "x": 1, "y": 16}, {"id": "city-sack-pile", "x": 10, "y": 16}, {"id": "city-sack-pile", "x": 12, "y": 16}, {"id": "light-candle", "x": 20, "y": 16}, {"id": "city-sack-pile", "x": 25, "y": 16}, {"id": "city-sack-pile", "x": 1, "y": 18}, {"id": "city-sack-pile", "x": 10, "y": 18}, {"id": "city-sack-pile", "x": 12, "y": 18}, {"id": "city-sack-pile", "x": 25, "y": 18}, {"id": "city-sack-pile", "x": 27, "y": 18}, {"id": "inn-stairs-down", "x": 29, "y": 18, "mirrorX": true}, {"id": "floor-connector", "x": 29, "y": 18, "targetMapId": "estalagem", "returnConnector": true}, {"id": "light-candle", "x": 31, "y": 18}, {"id": "city-bucket", "x": 2, "y": 19}, {"id": "light-candle", "x": 4, "y": 19}, {"id": "light-wall-torch", "x": 7, "y": 20}, {"id": "light-wall-torch", "x": 19, "y": 20}, {"id": "ember-interior-simple-bed-v02", "x": 2, "y": 1}, {"id": "ember-interior-simple-bed-v02", "x": 12, "y": 1}, {"id": "ember-interior-simple-bed-v02", "x": 17, "y": 1}, {"id": "ember-interior-simple-bed-v02", "x": 27, "y": 1}, {"id": "ember-interior-simple-bed-v02", "x": 30, "y": 1}, {"id": "ember-interior-simple-bed-v02", "x": 2, "y": 13}, {"id": "ember-interior-simple-bed-v02", "x": 14, "y": 19}, {"id": "ember-interior-simple-bed-v02", "x": 22, "y": 19}, {"id": "ember-tavern-table-v02", "x": 5, "y": 2}, {"id": "ember-tavern-table-v02", "x": 9, "y": 2}, {"id": "ember-tavern-table-v02", "x": 19, "y": 2}, {"id": "ember-tavern-table-v02", "x": 25, "y": 1}, {"id": "ember-tavern-table-v02", "x": 17, "y": 15}, {"id": "ember-tavern-table-v02", "x": 20, "y": 18}, {"id": "ember-tavern-table-v02", "x": 6, "y": 19}], "elementalFx": [], "playerSpawns": [{"name": "Kael", "classId": "kaelFinal", "x": 4, "y": 11, "level": 15}], "enemySpawns": [], "neutralSpawns": [{"name": "Isa, a Camareira", "classId": "villagerF1", "x": 7, "y": 9, "dialog": {"id": "npc-isa", "startId": "l1", "lines": [{"id": "l1", "speaker": "Isa, a Camareira", "portrait": "villagerF1", "text": "Troco lençol que ninguém quer deitar. Brue manda e eu obedeço: lavo o que dá pra lavar e fecho a porta do que não dá.", "next": null}]}, "level": 3}, {"name": "Guarda de Folga", "classId": "miliciaV2", "x": 20, "y": 11, "dialog": {"id": "npc-guarda-folga", "startId": "l1", "lines": [{"id": "l1", "speaker": "Guarda de Folga", "portrait": "soldier", "text": "Estou de folga. Quer dizer: durmo sentado, de armadura, de frente pra escada. Se alguém subir, eu acordo.", "next": null}]}, "level": 3}, {"name": "Tomas, o Febril", "classId": "peasant1", "x": 4, "y": 4, "dialog": {"id": "npc-tomas", "startId": "l1", "lines": [{"id": "l1", "speaker": "Tomas, o Febril", "portrait": "peasant1", "text": "Peguei a tosse na estrada do norte. Dizem que a cinza entra nos pulmões e fica. Brue me deixou a cama de graça, e isso me assusta mais que a tosse.", "next": null}]}, "level": 3}, {"name": "Dorminhoco", "classId": "beberrao", "x": 10, "y": 4, "dialog": {"id": "npc-dorminhoco", "startId": "l1", "lines": [{"id": "l1", "speaker": "Dorminhoco", "portrait": "beberrao", "text": "Shhh... eu subi pra dormir, não pra conversar. Se Brue perguntar, eu paguei. Se perguntar de novo, eu já dormi.", "next": null}]}, "level": 3}, {"name": "Dona Anselma", "classId": "soupLady", "x": 20, "y": 6, "dialog": {"id": "npc-anselma", "startId": "l1", "lines": [{"id": "l1", "speaker": "Dona Anselma", "portrait": "soupLady", "text": "Meu marido pagou este quarto até o fim do inverno. O inverno já passou três vezes. Brue não tem coragem de me dizer.", "next": null}]}, "level": 3}, {"name": "Garrick, o Caçador", "classId": "woodsman", "x": 28, "y": 4, "dialog": {"id": "npc-garrick", "startId": "l1", "lines": [{"id": "l1", "speaker": "Garrick, o Caçador", "portrait": "woodsman", "text": "Cacei o que me restava por três dias e voltei com uma pele de lobo. Aqui em cima ninguém pergunta de onde ela veio.", "next": null}]}, "level": 3}, {"name": "Berta da Cozinha", "classId": "breadLady", "x": 4, "y": 16, "dialog": {"id": "npc-berta", "startId": "l1", "lines": [{"id": "l1", "speaker": "Berta da Cozinha", "portrait": "breadLady", "text": "Durmo aqui com as outras da cozinha. Quatro camas, seis de nós. A gente reveza, e ninguém reclama do cheiro de cinza.", "next": null}]}, "level": 3}, {"name": "Nessa", "classId": "crazyLady", "x": 7, "y": 16, "dialog": {"id": "npc-nessa", "startId": "l1", "lines": [{"id": "l1", "speaker": "Nessa", "portrait": "crazyLady", "text": "Não durmo. Quando fecho os olhos, a vela da Louca lá embaixo se apaga e eu ouço eles na janela. Fico acordada por todas nós.", "next": null}]}, "level": 3}, {"name": "O Peregrino", "classId": "oldHealer", "x": 15, "y": 16, "dialog": {"id": "npc-peregrino", "startId": "l1", "lines": [{"id": "l1", "speaker": "O Peregrino", "portrait": "oldHealer", "text": "Atravessei três vilarejos queimados rezando por quem não pôde. Pago a noite com orações. Brue aceita. Raramente.", "next": null}]}, "level": 3}, {"name": "Homem de Capuz", "classId": "shadyPatron", "x": 21, "y": 16, "dialog": {"id": "npc-capuz", "startId": "l1", "lines": [{"id": "l1", "speaker": "Homem de Capuz", "portrait": "shadyPatron", "text": "Este quarto tem uma janela e uma porta. Sempre escolho assim. Se for me procurar, venha sozinho e de mãos vazias.", "next": null}]}, "level": 3}, {"name": "Nara", "classId": "roadCartographer", "x": 14, "y": 6, "dialog": {"id": "inn-guest-roadCartographer", "startId": "start", "lines": [{"id": "start", "speaker": "Nara", "portrait": "roadCartographer", "text": "Reservei uma cama. A dona trouxe uma mesa. Acho que entendeu meu problema melhor do que eu.", "replies": [{"text": "Está preparando uma viagem?", "next": "answer1"}, {"text": "Consegue descansar?", "next": "answer2"}, {"text": "Boa viagem.", "next": null}]}, {"id": "answer1", "speaker": "Nara", "portrait": "roadCartographer", "text": "Estou corrigindo as estradas do mapa. Três hóspedes juraram que a mesma ponte ficava em três lugares diferentes. Vou começar pelo rio; ele costuma ser mais sincero."}, {"id": "answer2", "speaker": "Nara", "portrait": "roadCartographer", "text": "Quando termino de marcar os caminhos, fecho os olhos e ainda vejo encruzilhadas. Talvez amanhã eu tente dormir sem a bússola debaixo do travesseiro."}]}, "level": 1}, {"name": "Erasmo", "classId": "shadowScholar", "x": 24, "y": 6, "dialog": {"id": "inn-guest-shadowScholar", "startId": "start", "lines": [{"id": "start", "speaker": "Erasmo", "portrait": "shadowScholar", "text": "A camareira proibiu discussões depois da meia-noite. Minha sombra entendeu isso como uma vitória.", "replies": [{"text": "Por que discute com ela?", "next": "answer1"}, {"text": "O livro é interessante?", "next": "answer2"}, {"text": "Boa viagem.", "next": null}]}, {"id": "answer1", "speaker": "Erasmo", "portrait": "shadowScholar", "text": "Ela acompanha todas as minhas leituras e nunca admite um erro. Um péssimo colega de quarto, mas extraordinariamente pontual."}, {"id": "answer2", "speaker": "Erasmo", "portrait": "shadowScholar", "text": "Muito. O capítulo sobre o silêncio tem trinta páginas. Pretendo ler algumas em voz alta para mostrar ao autor a ironia."}]}, "level": 1}, {"name": "Ada", "classId": "wanderingTinker", "x": 12, "y": 14, "dialog": {"id": "inn-guest-wanderingTinker", "startId": "start", "lines": [{"id": "start", "speaker": "Ada", "portrait": "wanderingTinker", "text": "A chaleira de Berta estava vazando. Agora o único barulho é o assoalho, e ele ainda não entrou no orçamento.", "replies": [{"text": "Você conserta tudo?", "next": "answer1"}, {"text": "Vai ficar na estalagem?", "next": "answer2"}, {"text": "Boa viagem.", "next": null}]}, {"id": "answer1", "speaker": "Ada", "portrait": "wanderingTinker", "text": "Panelas, fechos e fechaduras honestas. Corações ficam com o curandeiro e promessas eu devolvo sem garantia."}, {"id": "answer2", "speaker": "Ada", "portrait": "wanderingTinker", "text": "Até amanhã. Me deram jantar e uma cama em troca de quatro consertos. O ronco no quarto ao lado seria o quinto, mas não tenho ferramenta para isso."}]}, "level": 1}]}}