    "enemySpawns": [],
    "neutralSpawns": [
      {
        "name": "Isa, a Camareira",
        "classId": "villagerF1",
        "x": 5,
        "y": 7,
        "dialog": {
          "id": "npc-isa",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Isa, a Camareira",
              "portrait": "villagerF1",
              "text": "Troco lençol que ninguém quer deitar. Brue manda e eu obedeço: lavo o que dá pra lavar e fecho a porta do que não dá.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Guarda de Folga",
        "classId": "miliciaV2",
        "x": 14,
        "y": 8,
        "dialog": {
          "id": "npc-guarda-folga",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Guarda de Folga",
              "portrait": "soldier",
              "text": "Estou de folga. Quer dizer: durmo sentado, de armadura, de frente pra escada. Se alguém subir, eu acordo.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Tomas, o Febril",
        "classId": "peasant1",
        "x": 3,
        "y": 3,
        "dialog": {
          "id": "npc-tomas",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Tomas, o Febril",
              "portrait": "peasant1",
              "text": "Peguei a tosse na estrada do norte. Dizem que a cinza entra nos pulmões e fica. Brue me deixou a cama de graça, e isso me assusta mais que a tosse.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Dorminhoco",
        "classId": "beberrao",
        "x": 8,
        "y": 3,
        "dialog": {
          "id": "npc-dorminhoco",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Dorminhoco",
              "portrait": "beberrao",
              "text": "Shhh... eu subi pra dormir, não pra conversar. Se Brue perguntar, eu paguei. Se perguntar de novo, eu já dormi.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Dona Anselma",
        "classId": "soupLady",
        "x": 14,
        "y": 4,
        "dialog": {
          "id": "npc-anselma",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Dona Anselma",
              "portrait": "soupLady",
              "text": "Meu marido pagou este quarto até o fim do inverno. O inverno já passou três vezes. Brue não tem coragem de me dizer.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Garrick, o Caçador",
        "classId": "woodsman",
        "x": 20,
        "y": 3,
        "dialog": {
          "id": "npc-garrick",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Garrick, o Caçador",
              "portrait": "woodsman",
              "text": "Cacei o que me restava por três dias e voltei com uma pele de lobo. Aqui em cima ninguém pergunta de onde ela veio.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Berta da Cozinha",
        "classId": "breadLady",
        "x": 3,
        "y": 12,
        "dialog": {
          "id": "npc-berta",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Berta da Cozinha",
              "portrait": "breadLady",
              "text": "Durmo aqui com as outras da cozinha. Quatro camas, seis de nós. A gente reveza, e ninguém reclama do cheiro de cinza.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Nessa",
        "classId": "crazyLady",
        "x": 5,
        "y": 12,
        "dialog": {
          "id": "npc-nessa",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Nessa",
              "portrait": "crazyLady",
              "text": "Não durmo. Quando fecho os olhos, a vela da Louca lá embaixo se apaga e eu ouço eles na janela. Fico acordada por todas nós.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "O Peregrino",
        "classId": "oldHealer",
        "x": 11,
        "y": 12,
        "dialog": {
          "id": "npc-peregrino",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "O Peregrino",
              "portrait": "oldHealer",
              "text": "Atravessei três vilarejos queimados rezando por quem não pôde. Pago a noite com orações. Brue aceita. Raramente.",
              "next": null
            }
          ]
        },
        "level": 3
      },
      {
        "name": "Homem de Capuz",
        "classId": "shadyPatron",
        "x": 16,
        "y": 12,
        "dialog": {
          "id": "npc-capuz",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Homem de Capuz",
              "portrait": "shadyPatron",
              "text": "Este quarto tem uma janela e uma porta. Sempre escolho assim. Se for me procurar, venha sozinho e de mãos vazias.",
              "next": null
            }
          ]
        },
        "level": 3
      }
    ]
  }
}
