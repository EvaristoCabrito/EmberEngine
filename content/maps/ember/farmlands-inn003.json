s amanhã.", "next": null}]}, {"id": "more", "speaker": "Neera", "portrait": "neera", "text": "Ainda alerta. Mas aqui posso baixar a guarda por um instante.", "next": null}]}}, {"name": "Voss", "classId": "voss", "x": 10, "y": 12, "level": 1, "dialog": {"id": "farmlands-party-voss", "startId": "hello", "lines": [{"id": "hello", "speaker": "Voss", "portrait": "voss", "text": "O cheiro de terra e madeira me faz lembrar de lugares que ainda vale a pena proteger.", "replies": [{"text": "Como você está?", "next": "more"}, {"text": "Descanse. Seguimos amanhã.", "next": null}]}, {"id": "more", "speaker": "Voss", "portrait": "voss", "text": "Cansado, mas uma boa noite ajuda a pensar com clareza.", "next": null}]}}, {"name": "Salazar", "classId": "salazar", "x": 16, "y": 13, "level": 1, "dialog": {"id": "farmlands-party-salazar", "startId": "hello", "lines": [{"id": "hello", "speaker": "Salazar", "portrait": "salazar", "text": "Uma noite tranquila também é uma forma de misericórdia. Cuide de si, Kael.", "replies": [{"text": "Como você está?", "next": "more"}, {"text": "Descanse. Seguimos amanhã.", "next": null}]}, {"id": "more", "speaker": "Salazar", "portrait": "salazar", "text": "A fé não dispensa o descanso. Nenhum de nós precisa carregar tudo sozinho.", "next": null}]}}, {"name": "Aldric", "classId": "aldric", "x": 18, "y": 10, "level": 1, "dialog": {"id": "farmlands-party-aldric", "startId": "hello", "lines": [{"id": "hello", "speaker": "Aldric", "portrait": "aldric", "text": "Vou aproveitar a cama enquanto podemos. Amanhã seguimos juntos.", "replies": [{"text": "Como você está?", "next": "more"}, {"text": "Descanse. Seguimos amanhã.", "next": null}]}, {"id": "more", "speaker": "Aldric", "portrait": "aldric", "text": "Pronto para continuar quando todos estiverem descansados.", "next": null}]}}, {"name": "Malrec", "classId": "conjurer", "x": 20, "y": 11, "level": 1, "dialog": {"id": "farmlands-party-malrec", "startId": "hello", "lines": [{"id": "hello", "speaker": "Malrec