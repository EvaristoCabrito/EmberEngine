      {
        "name": "Lume, Guardião dos Esporos",
        "classId": "travelingMerchant",
        "x": 6,
        "y": 15,
        "level": 12,
        "dialog": {
          "id": "misty-sporehaven-npc-0",
          "startId": "welcome",
          "lines": [
            {
              "id": "welcome",
              "speaker": "Lume, Guardião dos Esporos",
              "text": "Bem-vindos a Esporabrigo. Somos o primeiro povo do micélio sob a névoa.",
              "replies": [
                {
                  "text": "O que existe mais abaixo?",
                  "next": "depths"
                },
                {
                  "text": "Como vivem aqui?",
                  "next": "home"
                },
                {
                  "text": "Até logo.",
                  "next": "bye"
                }
              ]
            },
            {
              "id": "depths",
              "speaker": "Lume, Guardião dos Esporos",
              "text": "A água desce até o céu de pedra. Além dele começam as terras interiores de Mordavia. Voltem por estas mesmas galerias quando precisarem da superfície.",
              "next": "welcome"
            },
            {
              "id": "home",
              "speaker": "Lume, Guardião dos Esporos",
              "text": "Cultivamos luz, alimento e memória nas raízes do micélio. Nossas casas são jovens; haverá muito mais para conhecer aqui.",
              "next": "welcome"
            },
            {
              "id": "bye",
              "speaker": "Lume, Guardião dos Esporos",
              "text": "Que a luz dos esporos acompanhe seus passos."
            }
          ]
        }
      },
