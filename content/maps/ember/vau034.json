    "introDialog": {
      "id": "vau-first-crossing-v01",
      "startId": "neera-current",
      "lines": [
        {
          "id": "neera-current",
          "speaker": "Neera",
          "portrait": "neera",
          "text": "A corrente virou a barca antes da margem. Há alguém preso ali?",
          "translations": {
            "en": "The current turned the boat before it reached the bank. Is someone trapped there?"
          },
          "next": "voss-tracks"
        },
        {
          "id": "voss-tracks",
          "speaker": "Voss",
          "portrait": "voss",
          "text": "Não. Olhem a lama: botas em formação. A milícia chegou antes de nós.",
          "translations": {
            "en": "No. Look at the mud: boots in formation. The militia got here before us."
          },
          "next": "kael-ford"
        },
        {
          "id": "kael-ford",
          "speaker": "Kael",
          "portrait": "kaelFinal",
          "text": "O vau continua sendo a única passagem. Se avançarmos, a corrente cobrirá nossos rastros.",
          "translations": {
            "en": "The ford is still the only way across. If we move now, the current will cover our tracks."
          },
          "next": "neera-plan"
        },
        {
          "id": "neera-plan",
          "speaker": "Neera",
          "portrait": "neera",
          "text": "Então atravessamos juntos. Eu cubro a margem; Voss vigia as árvores.",
          "translations": {
            "en": "Then we cross together. I will cover the bank; Voss can watch the tree line."
          },
          "next": "voss-question"
        },
        {
          "id": "voss-question",
          "speaker": "Voss",
          "portrait": "voss",
          "text": "E você, Kael?",
          "translations": {
            "en": "And you, Kael?"
          },
          "next": "kael-answer"
        },
        {
          "id": "kael-answer",
          "speaker": "Kael",
          "portrait": "kaelFinal",
          "text": "Eu abro a passagem. Ninguém fica para trás.",
          "translations": {
            "en": "I will open the way. No one gets left behind."
          }
        }
      ]
    }
  }
