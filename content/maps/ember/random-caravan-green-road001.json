      "lines": [
        {
          "id": "line-0",
          "speaker": "Mara, chefe da caravana",
          "text": "Ei! Vocês, na trilha! Há gente viva atrás dessas carroças!",
          "next": "line-1"
        },
        {
          "id": "line-1",
          "speaker": "Tomás, cocheiro",
          "text": "Eu disse que a estrada estava quieta demais. Mara disse que era porque eu finalmente tinha parado de cantar.",
          "next": "line-2"
        },
        {
          "id": "line-2",
          "speaker": "Ilda, curandeira",
          "text": "Guardem o fôlego para depois. Eles vêm pelo barranco e pela margem do riacho.",
          "next": "line-3"
        },
        {
          "id": "line-3",
          "speaker": "Mara, chefe da caravana",
          "text": "Levamos comida e remédios para uma aldeia que não pode esperar. Limpem a estrada e eu pago 400 Gold, mais 12 rações. Palavra de quem ainda pretende chegar em casa.",
          "next": "line-4"
        },
        {
          "id": "line-4",
          "speaker": "Kael",
          "text": "Fiquem junto às carroças. Vamos abrir caminho.",
          "next": null
        }
