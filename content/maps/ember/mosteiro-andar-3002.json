x": 2, "y": 11}, {"id": "ember-dungeon-chains", "x": 2, "y": 3}, {"id": "ember-crypt-ancient-bookshelf", "x": 3, "y": 2}, {"id": "ember-crypt-ancient-bookshelf", "x": 5, "y": 2}, {"id": "ember-crypt-ancient-bookshelf", "x": 7, "y": 2}, {"id": "ember-treasure-iron-banded-chest", "x": 13, "y": 11}, {"id": "ember-interior-table-candelabra", "x": 7, "y": 10}, {"id": "ember-crypt-ritual-brazier", "x": 2, "y": 7}, {"id": "ember-crypt-ritual-brazier", "x": 12, "y": 8}, {"id": "torture-chain-pile", "x": 11, "y": 11}, {"id": "dungeon-funerary-urn", "x": 13, "y": 7}, {"id": "light-candle", "x": 4, "y": 11}, {"id": "ember-dungeon-altar", "x": 23, "y": 3}, {"id": "dungeon-penitent-statue", "x": 21, "y": 2}, {"id": "dungeon-penitent-statue", "x": 26, "y": 2}, {"id": "ember-crypt-sarcophagus-v02", "x": 28, "y": 4}, {"id": "dungeon-hanging-cage", "x": 17, "y": 3}, {"id": "ember-mosteiro-votive-rack", "x": 19, "y": 4}, {"id": "wilds-incense-burner", "x": 25, "y": 5}, {"id": "ember-mosteiro-lectern", "x": 20, "y": 6}, {"id": "ember-mosteiro-pew", "x": 18, "y": 8}, {"id": "ember-mosteiro-pew", "x": 22, "y": 8}, {"id": "ember-mosteiro-pew", "x": 26, "y": 8}, {"id": "ember-mosteiro-pew", "x": 18, "y": 10}, {"id": "ember-mosteiro-pew", "x": 22, "y": 10}, {"id": "ember-mosteiro-pew", "x": 26, "y": 10}, {"id": "ember-crypt-secret-stone-door", "x": 30, "y": 8}, {"id": "ember-dungeon-iron-cage", "x": 30, "y": 11}, {"id": "ember-crypt-ritual-brazier", "x": 16, "y": 11}, {"id": "light-candle", "x": 24, "y": 12}, {"id": "dungeon-funerary-urn", "x": 17, "y": 12}, {"id": "ember-dungeon-chains", "x": 31, "y": 3}, {"id": "ember-interior-worn-rug", "x": 22, "y": 6}], "elementalFx": [], "playerSpawns": [{"name": "Kael", "classId": "kaelFinal", "x": 25, "y": 24, "level": 15}], "enemySpawns": [], "neutralSpawns": [{"name": "Irmão Guardião", "classId": "cultist", "x": 14, "y": 21, "level": 6, "dialog": {"id": "npc-mosteiro-guardiao", "startId": "l1", "lines": [{"id": "l1", "text": "Até aqui. O topo é do Abade e do conselho. A porta de pedra não se abre para hóspede, nem para irmão, nem para rei.", "replies": [{"text": "O que o conselho faz lá dentro?", "next": "l2"}, {"text": "Ouvimos um canto à noite.", "next": "l3"}, {"text": "Vamos descer."}], "speaker": "Irmão Guardião"}, {"id": "l2", "text": "Delibera. Reza. Lê as Lamentações nas margens. E escolhe. Não me pergunte o que escolhe.", "next": null, "speaker": "Irmão Guardião"}, {"id": "l3", "text": "Então ouviram errado. Aqui não se canta. Aqui se cumpre. Desçam, e não digam a ninguém que subiram.", "next": null, "speaker": "Irmão Guardião"}]}}, {"name": "Prior Vânio", "classId": "cultistV2", "x": 7, "y": 5, "level": 14, "dialog": {"id": "npc-mosteiro-prior", "startId": "l1", "lines": [{"id": "l1", "text": "Ora. Hóspedes no capítulo. A porta de pedra tinha um guardião... tinha. Sentem-se. Não? Então fiquem de pé, como os penitentes.", "replies": [{"text": "Onde está Tomé?", "next": "l2"}, {"text": "O que vocês fazem com os peregrinos?", "next": "l3"}, {"text": "Isto acaba hoje.", "next": "l4"}], "speaker": "Prior Vânio"}, {"id": "l2", "text": "Tomé. Forte, o Tomé. Bom pulmão. Desceu para servir a Cinza de um jeito que a mãe dele não entenderia. Vocês viram o pátio? Viram, sim. Ele os viu também. Não os reconheceu. A Cinza é misericordiosa assim.", "next": null, "speaker": "Prior Vânio"}, {"id": "l3", "text": "\"O que arde não se perde; o que se perde é refeito.\" Nós refazemos. Um homem que chega à nossa porta é cinza que ainda não sabe. Nós ensinamos. Por baixo da sacristia, onde o fogo não apaga.", "next": null, "speaker": "Prior Vânio"}, {"id": "l4", "text": "Acaba? Meu filho, isto começou antes do seu avô. A Cinza tem paciência. Desçam pela sacristia, se têm pressa. Lá embaixo o Abade recebe melhor do que eu.", "next": null, "speaker": "Prior Vânio"}]}}, {"name": "Mestre dos Noviços", "classId": "shadowScholar", "x": 4, "y": 8, "level": 12, "dialog": {"id": "npc-mosteiro-mestre", "startId": "l1", "lines": [{"id": "l1", "text": "Noviços novos? Não. Hóspedes. Hóspedes que sobem demais. Deixem-me olhar os seus olhos... Não. Ainda não. Pena.", "replies": [{"text": "O que você faz com os noviços?", "next": "l2"}, {"text": "Afaste-se."}], "speaker": "Mestre dos Noviços"}, {"id": "l2", "text": "Ensino a aguentar. Primeiro o jejum, depois a corrente, depois a cinza na boca. Quem aguenta, sobe. Quem não aguenta, desce, e aguenta de outro jeito. O Irmão Davi aguentou. Agora nem lembra que perguntou.", "next": null, "speaker": "Mestre dos Noviços"}]}}, {"name": "Irmã Superiora", "classId": "crazyLady", "x": 24, "y": 7, "level": 10, "dialog": {"id": "npc-mosteiro-superiora", "startId": "l1", "lines": [{"id": "l1", "text": "Shhh. A Santa dorme. Não a acordem com perguntas. Ela já respondeu tudo, há duzentos anos, quando ardeu e não se perdeu.", "replies": [{"text": "Quem está no sarcófago?", "next": "l2"}, {"text": "Por que a gaiola?", "next": "l3"}, {"text": "Deixe-a dormir."}], "speaker": "Irmã Superiora"}, {"id": "l2", "text": "Ela. O que sobrou. Cinza e um pouco de osso, e um coração que ainda está quente. Encoste a mão, se duvida. ...Não? Ninguém encosta. Só o Abade.", "next": null, "speaker": "Irmã Superiora"}, {"id": "l3", "text": "Para quem canta errado. Um dia e uma noite sem pão e sem chão, e o canto sai certo. Eu mesma cantei errado uma vez. Olhe para mim: sai certo.", "next": null, "speaker": "Irmã Superiora"}]}}, {"name": "Penitente Acorrentado", "classId": "chainBoundPenitent", "x": 11, "y": 16, "level": 9}, {"name": "Penitente Acorrentado", "classId": "chainBoundPenitent", "x": 21, "y": 16, "level": 9}], "aboveGround": true, "baseTile": "nave"}}