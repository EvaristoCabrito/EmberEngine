    "introDialog": {
      "id": "random-river-rope-ambush-intro",
      "startId": "line-0",
      "lines": [
        {
          "id": "line-0",
          "speaker": "Voss",
          "text": "Uma carroça vazia, cordas recém-cortadas e nenhuma pegada voltando pela estrada. Armadilha.",
          "next": "line-1"
        },
        {
          "id": "line-1",
          "speaker": "Kael",
          "text": "Já nos viram. A travessia do sul parece mais larga.",
          "next": "line-2"
        },
        {
          "id": "line-2",
          "speaker": "Neera",
          "text": "Ou podemos tomar a elevação e devolver a vista aos arqueiros. Com juros.",
          "next": null
        }
      ]
    },
    "outroDialogEnabled": true,
    "outroDialog": {
      "id": "random-river-rope-ambush-outro",
      "startId": "line-0",
      "lines": [
        {
          "id": "line-0",
          "speaker": "Voss",
          "text": "A carga roubada estava escondida na outra margem. Eles planejavam voltar quando a água baixasse.",
          "next": "line-1"
        },
        {
          "id": "line-1",
          "speaker": "Kael",
          "text": "Agora a travessia fica aberta. Que o próximo viajante encontre apenas um rio.",
          "next": null
        }
      ]
    }
  }
