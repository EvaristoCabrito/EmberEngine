        "dialog": {
          "id": "encounter-swampFerryman",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Rúben",
              "portrait": "swampFerryman",
              "text": "A água parece rasa porque quer que você desça primeiro.",
              "replies": [
                {
                  "text": "Onde fica a travessia?",
                  "next": "answer1"
                },
                {
                  "text": "Você conhece este rio?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Rúben",
              "portrait": "swampFerryman",
              "text": "Perto das pedras largas, ao sul. Solte a correia da mochila antes de entrar. Se a corrente puxar, deixe a carga ir."
            },
            {
              "id": "answer2",
              "speaker": "Rúben",
              "portrait": "swampFerryman",
              "text": "Conheço o que ele mostra. O resto eu respeito. É assim que um barqueiro chega a velho."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Nara",
        "classId": "roadCartographer",
        "x": 4,
        "y": 12,
        "dialog": {
          "id": "encounter-roadCartographer",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Nara",
              "portrait": "roadCartographer",
              "text": "Este mapa diz que há uma ponte adiante. A bússola discorda. Eu costumo confiar na que não cobra tinta.",
              "replies": [
                {
                  "text": "Por que a bússola discorda?",
                  "next": "answer1"
