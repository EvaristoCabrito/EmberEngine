    "introDialog": {
      "id": "random-broken-antler-grove-intro",
      "startId": "line-0",
      "lines": [
        {
          "id": "line-0",
          "speaker": "Neera",
          "text": "Esses símbolos não foram riscados pelo tempo. Alguém os cortou de propósito.",
          "next": "line-1"
        },
        {
          "id": "line-1",
          "speaker": "Voss",
          "text": "Os vigias também não parecem muito interessados em receber visitantes.",
          "next": "line-2"
        },
        {
          "id": "line-2",
          "speaker": "Salazar",
          "text": "O círculo está cercado de ossos recentes. Vamos acabar com o ritual antes que ganhe uma voz.",
          "next": null
        }
      ]
    },
    "outroDialogEnabled": true,
    "outroDialog": {
      "id": "random-broken-antler-grove-outro",
      "startId": "line-0",
      "lines": [
        {
          "id": "line-0",
          "speaker": "Salazar",
          "text": "O canto parou. As marcas antigas ainda estão sob os riscos; talvez o bosque saiba se refazer.",
          "next": "line-1"
        },
        {
          "id": "line-1",
          "speaker": "Neera",
          "text": "Deixem as pedras em paz. Levaremos só o que os profanadores roubaram dos viajantes.",
          "next": null
        }
      ]
    }
