    "neutralSpawns": [
      {
        "name": "Portador do braseiro",
        "classId": "ancientGolem",
        "x": 10,
        "y": 7,
        "level": 8,
        "dialog": {
          "id": "campfire-guide",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Voz nas brasas",
              "text": "O fogo se alimenta de lembranças. Quando o caminho estiver livre, seguiremos até o templo. Você pode vir conosco."
            }
          ]
        }
      },
      {
        "name": "Dário",
        "classId": "charcoalBurner",
        "x": 2,
        "y": 9,
        "dialog": {
          "id": "encounter-charcoalBurner",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Dário",
              "portrait": "charcoalBurner",
              "text": "O fogo faz o serviço. Eu só passo o dia convencendo a madeira a não discutir.",
              "replies": [
                {
                  "text": "Viu gente armada por aqui?",
                  "next": "answer1"
                },
                {
                  "text": "Como se ganha a vida aqui?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Dário",
              "portrait": "charcoalBurner",
              "text": "Vi botas limpas entrando e botas ensanguentadas saindo. Gente honesta costuma deixar a lama fazer o trabalho primeiro."
            },
            {
              "id": "answer2",
              "speaker": "Dário",
              "portrait": "charcoalBurner",
              "text": "Um saco de carvão de cada vez. A cidade quer calor, mas prefere esquecer de onde ele vem."
            }
          ]
        },
        "level": 1
      },
      {
        "name": "Ada",
        "classId": "wanderingTinker",
        "x": 4,
        "y": 10,
        "dialog": {
          "id": "encounter-wanderingTinker",
          "startId": "start",
          "lines": [
            {
              "id": "start",
              "speaker": "Ada",
              "portrait": "wanderingTinker",
              "text": "Se faz barulho, tem conserto. Quando fica quieto demais é que eu começo a cobrar por preocupação.",
              "replies": [
                {
                  "text": "Pode consertar essa chaleira?",
                  "next": "answer1"
                },
                {
                  "text": "O que viu na estrada?",
                  "next": "answer2"
                },
                {
                  "text": "Boa viagem.",
                  "next": null
                }
              ]
            },
            {
              "id": "answer1",
              "speaker": "Ada",
              "portrait": "wanderingTinker",
              "text": "Posso. Ela perdeu uma alça e a dignidade, mas ainda guarda água melhor que muita gente guarda segredo."
            },
            {
              "id": "answer2",
              "speaker": "Ada",
              "portrait": "wanderingTinker",
              "text": "Uma carroça sem roda, três mentiras bem vestidas e um homem negociando com uma árvore. A árvore parecia levar vantagem."
            }
          ]
        },
        "level": 1
      }
    ],
    "introDialogEnabled": true,
    "introDialog": {
      "id": "random-walking-campfire-intro",
      "startId": "start",
      "lines": [
        {
          "id": "start",
          "speaker": "Narrador",
          "text": "Na nevasca, uma luz acompanha um construto de pedra. Um braseiro preso às suas costas aquece os viajantes, e objetos queimados mostram lembranças nas chamas. Saqueadores surgem nas duas alas da clareira."
        }
      ]
    },
    "outroDialogEnabled": true,
    "outroDialog": {
      "id": "random-walking-campfire-outro",
      "startId": "start",
      "lines": [
        {
          "id": "start",
          "speaker": "Narrador",
          "text": "A clareira está livre. O construto retoma sua marcha em direção ao templo distante. Nas brasas, uma última lembrança mostra suas portas abertas, convidando os viajantes a seguir."
        }
      ]
    }
  }
