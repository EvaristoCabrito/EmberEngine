        "dialog": {
          "id": "deep-mist-dario",
          "startId": "greeting",
          "lines": [
            {
              "id": "greeting",
              "speaker": "Dario",
              "portrait": "woodsman",
              "text": "Não siga cada luz que vir. Algumas tochas foram acesas por gente que já morreu.",
