        "x": 24,
        "y": 10,
        "level": 10,
        "dialog": {
          "id": "deep-mist-iria",
          "startId": "greeting",
          "lines": [
            {
              "id": "greeting",
              "speaker": "Iria",
              "portrait": "crazyLady",
              "text": "Eu conto as velas para não escutar o que se move debaixo da água.",
              "replies": [
                {
                  "text": "Como atravesso a água?",
                  "next": "topic0"
                },
                {
                  "text": "O que guarda o santuário?",
                  "next": "topic1"
                },
                {
                  "text": "Por que deixa velas aqui?",
                  "next": "topic2"
                },
                {
                  "text": "Quem é você?",
                  "next": "topic3"
