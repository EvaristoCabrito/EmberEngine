+SpellMovementPreview spellMovementPreview(const Battle& b, size_t caster, const std::string& kind, BattleHex cell) {
+  SpellMovementPreview out;
+  if (caster >= b.units().size()) return out;
+  const BattleUnit& u = b.units()[caster];
+  const BattleHex from{u.x, u.y};
+  const int here = occAt(b, cell);
+
+  if (kind == "poleVault") {
+    if (const std::optional<BattleHex> landing = vaultLanding(b, caster, cell)) {
+      out.valid = true;
+      out.casterDestination = landing;
+      out.targetDestination = cell;
+      if (here >= 0) out.targetUnit = static_cast<size_t>(here);
+      out.trajectory = {from, cell, *landing};
+    }
+  } else if (kind == "spearToss") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    if (const std::optional<TossPlan> p = tossPlan(b, caster, cell, n)) {
+      out.valid = true;
+      out.targetUnit = p->foe;
+      out.targetDestination = p->landing ? p->landing : (p->collide ? BattleHex{b.units()[*p->collide].x, b.units()[*p->collide].y} : cell);
+      out.collidedUnit = p->collide;
+      out.trajectory = p->tiles;
+      out.casterDestination = from;
+    }
+  } else if (kind == "hookPull") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    if (const std::optional<HookPlan> p = hookPlan(b, caster, cell, n)) {
+      out.valid = true;
+      out.targetUnit = p->foe;
+      out.targetDestination = p->dest;
+      out.trajectory = p->line;
+      out.casterDestination = from;
+    }
+  } else if (kind == "swapPost" || kind == "placeSwap") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    if (const int ally = swapAlly(b, caster, cell, n); ally >= 0) {
+      out.valid = true;
+      out.casterDestination = cell;
+      out.targetDestination = from;
+      out.targetUnit = static_cast<size_t>(ally);
+      out.trajectory = {from, cell};
+    }
+  } else if (kind == "impaleDrag") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    if (const std::optional<DragPlan> p = dragPlan(b, caster, cell, n)) {
+      out.valid = true;
+      out.casterDestination = p->casterTo;
+      out.targetDestination = p->foeTo;
+      out.targetUnit = p->foe;
+      out.trajectory = p->tiles;
+    }
+  } else if (kind == "bullRush") {
+    if (const std::optional<std::vector<RushLeg>> legs = bullRushCharge(b, caster, cell)) {
+      if (!legs->empty()) {
+        out.valid = true;
+        const RushLeg& last = legs->back();
+        out.casterDestination = last.path.empty() ? from : last.path.back();
+        out.targetDestination = last.push.path.empty() ? cell : last.push.path.back();
+        out.targetUnit = last.foe;
+        for (const auto& leg : *legs) {
+          out.trajectory.insert(out.trajectory.end(), leg.path.begin(), leg.path.end());
+          out.trajectory.insert(out.trajectory.end(), leg.push.path.begin(), leg.push.path.end());
+        }
+      }
+    }
+  } else if (kind == "abyssalSwap") {
+    if (here >= 0 && canAbyssalSwap(b, caster, static_cast<size_t>(here))) {
+      out.valid = true;
+      out.casterDestination = cell;
+      out.targetDestination = from;
+      out.targetUnit = static_cast<size_t>(here);
+      out.trajectory = {from, cell};
+    }
+  } else if (kind == "leapingStrike") {
+    if (here >= 0) {
+      const EmberNumbers n = emberNumbers(kind, u.level);
+      if (const std::optional<BattleHex> landing = leapLanding(b, caster, static_cast<size_t>(here), n.range)) {
+        out.valid = true;
+        out.casterDestination = landing;
+        out.targetDestination = cell;
+        out.targetUnit = static_cast<size_t>(here);
+        out.trajectory = {from, *landing};
+      }
+    }
+  } else if (kind == "drivingCut") {
+    if (here >= 0 && targetable(b, here) && hexDist(from, cell) == 1) {
+      const BattleHex past = hexBeyond(from, cell);
+      out.valid = true;
+      out.casterDestination = cell;
+      out.targetDestination = past;
+      out.targetUnit = static_cast<size_t>(here);
+      out.trajectory = {from, cell, past};
+    }
+  } else if (kind == "rollingAdvance") {
+    if (here >= 0 && targetable(b, here) && hexDist(from, cell) == 1) {
+      const BattleHex f1 = hexBeyond(from, cell);
+      const BattleHex f2 = hexBeyond(cell, f1);
+      out.valid = true;
+      out.casterDestination = cell;
+      out.targetDestination = f2;
+      out.targetUnit = static_cast<size_t>(here);
+      out.trajectory = {from, cell, f1, f2};
+    }
+  } else if (kind == "shoulderSmash") {
+    if (here >= 0 && targetable(b, here)) {
+      if (const std::optional<BattleHex> m = shoulderMiddle(b, from, cell)) {
+        const BattleHex past = hexBeyond(*m, cell);
+        out.valid = true;
+        out.casterDestination = *m;
+        out.targetDestination = past;
+        out.targetUnit = static_cast<size_t>(here);
+        out.trajectory = {from, *m, cell, past};
+      }
+    }
+  } else if (kind == "longStep" || kind == "partingCut" || kind == "passingStep") {
+    if (hexDist(from, cell) == 1 && techniqueStandable(b, cell)) {
+      out.valid = true;
+      out.casterDestination = cell;
+      out.trajectory = {from, cell};
+    }
+  } else if (kind == "lateralShift") {
+    if (hexDist(from, cell) == 1 && techniqueStandable(b, cell)) {
+      out.valid = true;
+      out.targetDestination = cell;
+      out.trajectory = {from, cell};
+    }
+  }
+  return out;
+}
