+    if (kind == "resurrection") return en ? "Confirm resurrection" : "Confirmar ressurreição";
+    if (spellTargetsAlly(kind)) return en ? "Confirm action on ally" : "Confirmar ação no aliado";
+    if (spellAimsDirection(kind)) return en ? "Confirm directional attack" : "Confirmar ataque direcional";
+    if (spellTargetsGroundOrFreeHex(kind)) return en ? "Confirm area cast" : "Confirmar conjuração na área";
+    return en ? "Confirm action" : "Confirmar ação";
+  }
+
+  // Multi-stage abilities
+  if (kind == "twinResonance") {
+    if (stage == 1) return en ? "Select second linked enemy" : "Escolha o segundo inimigo ligado";
+    return en ? "Select first enemy" : "Escolha o primeiro inimigo";
+  }
+  if (kind == "longstepSlash" || kind == "longStep" || kind == "flankStep") {
+    if (stage == 1) return en ? "Select enemy to strike (or step hex)" : "Escolha o inimigo para golpear (ou o hex de avanço)";
+    return en ? "Select adjacent free hex to step into (or click enemy directly)" : "Escolha o hex livre adjacente para avançar (ou clique direto no inimigo)";
+  }
+  if (kind == "partingCut") {
+    if (stage == 1) return en ? "Select retreat hex" : "Escolha o hex de recuo";
+    return en ? "Select adjacent enemy to strike" : "Escolha o inimigo adjacente para golpear";
+  }
+  if (kind == "passingStep") {
+    if (stage == 1) return en ? "Select flanking hex" : "Escolha o hex de flanco";
+    return en ? "Select adjacent enemy" : "Escolha o inimigo adjacente";
+  }
+  if (kind == "lateralShift") {
+    if (stage == 1) return en ? "Select destination hex to shift enemy" : "Escolha o hex para onde deslocar o inimigo";
+    return en ? "Select adjacent enemy" : "Escolha o inimigo adjacente";
+  }
+  if (caster < b.units().size()) {
+    if (kind == "magicMissile" || kind == "magicMissileV2") {
+      const int count = magicMissileCount(b.units()[caster].level);
+      if (stage > 0) return en ? std::format("Select target for missile {} of {}", stage + 1, count) : std::format("Escolha o alvo do míssil {} de {}", stage + 1, count);
+      return en ? std::format("Select target for missile 1 of {}", count) : std::format("Escolha o alvo do míssil 1 de {}", count);
+    }
+    if (kind == "wrathOfTheSkies") {
+      const int count = emberNumbers(kind, b.units()[caster].level).count;
+      if (stage > 0) return en ? std::format("Select target for bolt {} of {}", stage + 1, count) : std::format("Escolha o alvo do raio {} de {}", stage + 1, count);
+      return en ? std::format("Select target for bolt 1 of {}", count) : std::format("Escolha o alvo do raio 1 de {}", count);
+    }
+    if (kind == "multiShot") {
+      const int count = multiShotTargets(b.units()[caster].level);
+      if (stage > 0) return en ? std::format("Select target for arrow {} of {}", stage + 1, count) : std::format("Escolha o alvo da flecha {} de {}", stage + 1, count);
+      return en ? std::format("Select target for arrow 1 of {}", count) : std::format("Escolha o alvo da flecha 1 de {}", count);
+    }
+  }
+
+  // Single-stage abilities
+  if (kind == "spearToss") {
+    return en ? "Select landing or collision hex" : "Escolha o hex de destino ou impacto";
+  }
+  if (kind == "hookPull") {
+    return en ? "Select enemy to pull" : "Escolha o inimigo a puxar";
+  }
+  if (kind == "poleVault") {
+    return en ? "Select adjacent enemy to vault over" : "Escolha o inimigo adjacente para saltar por cima";
+  }
+  if (kind == "swapPost" || kind == "placeSwap") {
+    return en ? "Select ally to swap places" : "Escolha o aliado para trocar de lugar";
+  }
+  if (kind == "impaleDrag") {
+    return en ? "Select enemy or straight line behind to drag" : "Escolha o inimigo ou a reta atrás dele para arrastar";
+  }
+  if (kind == "sentinelVigil") {
+    return en ? "Confirm defensive stance" : "Confirmar postura defensiva";
+  }
+  if (kind == "piercingThrust") {
+    return en ? "Select thrust direction in front" : "Escolha a reta na frente para o golpe perfurante";
+  }
+  if (kind == "sweep") {
+    return en ? "Confirm sweeping attack around" : "Confirmar varredura ao redor";
+  }
+  if (kind == "trip" || kind == "disarm" || kind == "doubleStrike" || kind == "shieldBash" ||
+      kind == "guardBreak" || kind == "holyStrike" || kind == "executionerStrike") {
+    return en ? "Select enemy in weapon reach" : "Escolha o inimigo ao alcance da arma";
+  }
+  if (kind == "bullRush") {
+    return en ? "Select enemy in line to charge" : "Escolha o inimigo em linha para a investida";
+  }
+  if (kind == "leapingStrike") {
+    return en ? "Select enemy to leap strike" : "Escolha o inimigo para o salto de ataque";
+  }
+  if (kind == "cleave") {
+    return en ? "Choose attack direction for sweeping arc" : "Escolha a direção para o arco de ataque";
+  }
+  if (kind == "shoulderSmash") {
+    return en ? "Select enemy 2 hexes away in straight line" : "Escolha o inimigo a 2 hexes em linha reta";
+  }
+  if (kind == "resurrection") {
+    return en ? "Select adjacent fallen ally" : "Escolha o aliado caído adjacente";
+  }
+  if (kind == "circleOfHealing") {
+    return en ? "Select center of healing circle" : "Escolha o centro do círculo de cura";
+  }
+  if (kind == "cureDisease") {
+    return en ? "Select diseased or poisoned ally" : "Escolha o aliado doente ou envenenado";
+  }
+  if (cureData(kind) != nullptr || kind == "holyTouch") {
+    return en ? "Select hurt ally to heal" : "Escolha o aliado ferido para curar";
+  }
+  if (spellTargetsAlly(kind)) {
+    return en ? "Select target ally" : "Escolha o aliado alvo";
+  }
+  if (spellAimsDirection(kind)) {
+    return en ? "Choose attack direction" : "Escolha a direção do ataque";
+  }
+  if (spellTargetsGroundOrFreeHex(kind)) {
+    return en ? "Select target area" : "Escolha o ponto de impacto";
+  }
+  return en ? "Select target" : "Escolha o alvo";
+}
+
+bool spellHasValidTargets(const Battle& b, size_t caster, const std::string& kind) {
+  if (caster >= b.units().size()) return false;
+  const BattleUnit& u = b.units()[caster];
+  if (!u.alive || spellPassive(kind)) return false;
+  if (spellInstant(kind) || spellSelfArea(kind)) return true;
+
+  if (kind == "spearToss") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    for (const BattleHex& h : Battle::neighbors(u.x, u.y)) {
+      const int foe = occAt(b, h);
+      if (targetable(b, foe) && oneHex(b.units()[static_cast<size_t>(foe)])) {
+        if (tossPlan(b, caster, h, n)) return true;
+      }
+    }
+    return false;
+  }
+  if (kind == "impaleDrag") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    for (const BattleHex& h : Battle::neighbors(u.x, u.y)) {
+      const int foe = occAt(b, h);
+      if (targetable(b, foe) && oneHex(b.units()[static_cast<size_t>(foe)])) {
+        if (dragPlan(b, caster, h, n)) return true;
+      }
+    }
+    return false;
+  }
+  if (kind == "poleVault") {
+    for (const BattleHex& h : Battle::neighbors(u.x, u.y)) {
+      if (vaultLanding(b, caster, h)) return true;
+    }
+    return false;
+  }
+  if (kind == "hookPull") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& t = b.units()[i];
+      if (!t.alive || t.side == u.side || t.hidden) continue;
+      if (hookPlan(b, caster, {t.x, t.y}, n)) return true;
+    }
+    return false;
+  }
+  if (kind == "swapPost" || kind == "placeSwap") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& a = b.units()[i];
+      if (i == caster || !a.alive || a.side != u.side) continue;
+      if (swapAlly(b, caster, {a.x, a.y}, n) >= 0) return true;
+    }
+    return false;
+  }
+  if (kind == "resurrection") {
+    for (const BattleHex& h : Battle::neighbors(u.x, u.y)) {
+      if (fallenAllyAt(b, caster, h) >= 0 && occAt(b, h) < 0) return true;
+    }
+    return false;
+  }
+  if (kind == "cureDisease") {
+    const int reach = grownReach(kind, kCureDiseaseRange, u.level);
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& a = b.units()[i];
+      if (!a.alive || a.side != u.side) continue;
+      if (hexDist({u.x, u.y}, {a.x, a.y}) <= reach && (a.diseased || a.poisoned)) return true;
+    }
+    return false;
+  }
+  if (const CureData* cure = cureData(kind)) {
+    const int reach = grownReach(kind, cure->range, u.level);
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& a = b.units()[i];
+      if (!a.alive || a.side != u.side) continue;
+      if (hexDist({u.x, u.y}, {a.x, a.y}) <= reach && (b.debugFreeCast() || a.hp < a.maxHp)) return true;
+    }
+    return false;
+  }
+  if (kind == "holyTouch") {
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& a = b.units()[i];
+      if (i == caster || !a.alive || a.side != u.side) continue;
+      if (hexDist({u.x, u.y}, {a.x, a.y}) <= 1 && (b.debugFreeCast() || a.hp < a.maxHp)) return true;
+    }
+    return false;
+  }
+  if (kind == "detonateSummon") {
+    return !summonsOf(b, caster).empty();
+  }
+  if (kind == "bullRush") {
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& f = b.units()[i];
+      if (!f.alive || f.side == u.side || f.hidden) continue;
+      if (bullRushCharge(b, caster, {f.x, f.y})) return true;
+    }
+    return false;
+  }
+  if (kind == "leapingStrike") {
+    const EmberNumbers n = emberNumbers(kind, u.level);
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& f = b.units()[i];
+      if (!f.alive || f.side == u.side || f.hidden) continue;
+      if (leapLanding(b, caster, i, n.range)) return true;
+    }
+    return false;
+  }
+  if (spellTargetsAlly(kind)) {
+    for (size_t i = 0; i < b.units().size(); ++i) {
+      const BattleUnit& a = b.units()[i];
+      if (!a.alive || a.side != u.side) continue;
+      if (spellAimValid(b, caster, kind, {a.x, a.y})) return true;
+    }
+    return false;
+  }
+  if (spellAimsDirection(kind) || spellTargetsGroundOrFreeHex(kind)) {
+    return !spellZone(b, caster, kind).empty();
+  }
+  for (size_t i = 0; i < b.units().size(); ++i) {
+    const BattleUnit& f = b.units()[i];
+    if (!f.alive || f.side == u.side || f.hidden) continue;
+    if (spellAimValid(b, caster, kind, {f.x, f.y})) return true;
+  }
+  return false;
+}
